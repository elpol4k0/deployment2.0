{
    "name": "agiqon/project-name",
    "version": "1.0.0",
    "type": "project",
    "license": "proprietary",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "bamarni/composer-bin-plugin": true
        },
        "gitlab-domains": ["gitlab.agiqon.de"]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "endpoint": [
                "https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json",
                "flex://defaults"
            ]
        },
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        },
        "stage-overrides": {
        }
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.shopware.com"
        },
        {
            "type": "git",
            "url": "https://gitlab.agiqon.de/general/shopware-6/plugins/agiqoncore.git"
        },
        {
            "type": "path",
            "url": "custom/plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/plugins/*/packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "git",
            "url": "https://gitlab.agiqon.de/[LINK_TO_REPOSITORY]"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.0",
        "symfony/flex": "^2.4",

        "shopware/administration": "[SHOPWARE_VERSION]",
        "shopware/core": "[SHOPWARE_VERSION]",
        "shopware/elasticsearch": "[SHOPWARE_VERSION]",
        "shopware/storefront": "[SHOPWARE_VERSION]",

        "shopware/deployment-helper": "*",

        "frosh/shopmon": "0.2.0",

        "agiqon/core": "6.6.0",
        "agiqon/[PLUGIN_NAME]": "dev-main",

        "store.shopware.com/[PLUGIN_NAME]": "^1.0"
    },
    "require-dev": {
        "ext-openssl": "*",
        "ext-tokenizer": "*",
        "bamarni/composer-bin-plugin": "^1.8",
        "frosh/code-quality-meta": "^0.5",
        "dg/bypass-finals": "^1.4",
        "league/flysystem-memory": "~3.10",
        "shopware/dev-tools": "^1.3",
        "phpunit/phpunit": "^12.5",
        "symfony/css-selector": "*",
        "symfony/dom-crawler": "*",
        "symfony/phpunit-bridge": "*",
        "frosh/tools": "3.8.2",
        "frosh/development-helper": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "apply-patches": [
            "[ ! -f patches/shopware-translator.patch ] || patch -N -p0 < patches/shopware-translator.patch; true"
        ],
        "pre-install-cmd": [
            "[ ! -f vendor/autoload.php ] || $PHP_BINARY bin/console system:update:prepare"
        ],
        "pre-update-cmd": [
            "[ ! -f vendor/autoload.php ] || $PHP_BINARY bin/console system:update:prepare"
        ],
        "post-install-cmd": [
            "[ ! -f vendor/autoload.php ] || $PHP_BINARY bin/console system:update:finish"
        ],
        "post-update-cmd": [
            "[ ! -f vendor/autoload.php ] || $PHP_BINARY bin/console system:update:finish"
        ],

        "npm:admin": "@npm:admin:bin npm",
        "npm:admin:bin": "export PROJECT_ROOT=\"$PWD\"; cd vendor/shopware/administration/Resources/app/administration; export PATH=\"$PWD/node_modules/.bin/:$PATH\"; \"$PROJECT_ROOT\"/bin/exec-with-env ",
        "npm:storefront": "@npm:storefront:bin npm",
        "npm:storefront:bin": "export PROJECT_ROOT=\"$PWD\"; cd vendor/shopware/storefront/Resources/app/storefront; export PATH=\"$PWD/node_modules/.bin/:$PATH\"; \"$PROJECT_ROOT\"/bin/exec-with-env ",
        "npm:component-library": "@npm:component-library:bin npm",
        "npm:component-library:bin": "export PROJECT_ROOT=\"$PWD\"; cd vendor/shopware/administration/Resources/app/administration/build/nuxt-component-library; export PATH=\"$PWD/node_modules/.bin/:$PATH\"; \"$PROJECT_ROOT\"/bin/exec-with-env ",

        "build:js": [
            "@build:js:admin",
            "@build:js:storefront"
        ],
        "build:js:admin": [
            "@php bin/console bundle:dump",
            "@php bin/console feature:dump",
            "@npm:admin run build",
            "@php bin/console assets:install"
        ],
        "build:js:storefront": [
            "@php bin/console bundle:dump",
            "@php bin/console feature:dump",
            "@npm:storefront run production",
            "@php bin/console assets:install",
            "@php bin/console theme:compile --sync || true"
        ],
        "watch:admin": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/console feature:dump",
            "@php bin/console bundle:dump",
            "@npm:admin run dev"
        ],
        "watch:storefront": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/console bundle:dump",
            "@php bin/console feature:dump",
            "@php bin/console theme:dump",
            "@npm:storefront run hot-proxy"
        ],
        "storefront:dev-server": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/console bundle:dump",
            "@php bin/console feature:dump",
            "@php bin/console theme:dump",
            "@npm:storefront run dev:server"
        ],

        "admin:unit": [
            "Composer\\Config::disableProcessTimeout",
            "@npm:admin run unit-setup",
            "@npm:admin run unit"
        ],
        "admin:unit:watch": [
            "Composer\\Config::disableProcessTimeout",
            "@npm:admin run unit-setup",
            "@npm:admin run unit-watch"
        ],
        "storefront:unit": [
            "@npm:storefront run unit"
        ],
        "storefront:unit:watch": [
            "Composer\\Config::disableProcessTimeout",
            "@npm:storefront run unit-watch"
        ],

        "eslint": [
            "@eslint:admin",
            "@eslint:storefront"
        ],
        "eslint:admin": "@npm:admin run lint:all",
        "eslint:admin:fix": "@npm:admin run lint:fix",
        "eslint:storefront": "@npm:storefront run lint:js",
        "eslint:storefront:fix": "@npm:storefront run lint:js:fix",
        "stylelint": [
            "@stylelint:admin src/**/*.scss",
            "@stylelint:storefront src/**/*.scss"
        ],
        "stylelint:admin": "@npm:admin run lint:scss",
        "stylelint:admin:fix": "@npm:admin run lint:scss-fix",
        "stylelint:storefront": "@npm:storefront run lint:scss",
        "stylelint:storefront:fix": "@npm:storefront run lint:scss-fix",
        "format:admin": "@npm:admin run format",
        "format:admin:fix": "@npm:admin run format:fix",

        "ludtwig:storefront": "cd ./vendor/shopware/storefront/Resources/views; ludtwig .",
        "ludtwig:storefront:fix": "@ludtwig:storefront --fix",

        "hook:pre-commit": ["bin/pre-commit"],
        "hook:pre-commit:install": ["ln -sf $PWD/bin/pre-commit .git/hooks/pre-commit"],
        "hook:pre-push": ["bin/pre-commit"],
        "hook:pre-push:install": ["ln -sf $PWD/bin/pre-push .git/hooks/pre-push"],

        "cs": "@php vendor-bin/cs-fixer/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes --dry-run --diff",
        "cs-fix": "@php vendor-bin/cs-fixer/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes --diff",
        "phpstan": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/shopware/core/DevOps/StaticAnalyze/phpstan-bootstrap.php",
            "@php vendor-bin/phpstan/vendor/bin/phpstan analyze"
        ],
        "phpunit": "@php vendor/bin/phpunit",
        "rector": "@php vendor-bin/rector/vendor/bin/rector process",
        "rector-dry": "@php vendor-bin/rector/vendor/bin/rector process --dry-run"
    },
    "scripts-descriptions": {
        "apply-patches": "Apply custom patches from patches/ directory",
        "npm:admin": "Run npm in the Administration app context",
        "npm:storefront": "Run npm in the Storefront app context",
        "npm:component-library": "Run npm in the component library context",
        "build:js": "Builds Administration & Storefront",
        "build:js:admin": "Builds the Administration",
        "build:js:storefront": "Builds the Storefront's JavaScript",
        "watch:admin": "Enables hot module reloading for the Admin",
        "watch:storefront": "Enables hot module reloading for the Storefront (legacy). Use storefront:dev-server instead.",
        "storefront:dev-server": "Starts the Vite dev server for the Storefront",
        "admin:unit": "Launches the jest unit test-suite for the Admin",
        "admin:unit:watch": "Launches the interactive jest unit test-suite watcher for the Admin",
        "storefront:unit": "Launches the jest unit test-suite for the Storefront",
        "storefront:unit:watch": "Launches the interactive jest unit test-suite watcher for the Storefront",
        "eslint": "Codestyle checks all (Administration/Storefront) JS/TS files",
        "eslint:admin": "Codestyle checks Administration JS/TS files",
        "eslint:admin:fix": "Codestyle checks Administration JS/TS files and fixes them if possible",
        "eslint:storefront": "Codestyle checks all Storefront JS/TS files",
        "eslint:storefront:fix": "Codestyle checks all Storefront JS/TS files and fixes them if possible",
        "stylelint": "Codestyle checks all SCSS files of Administration and Storefront",
        "stylelint:admin": "Code Style checks for all Admin SCSS files",
        "stylelint:admin:fix": "Code Style checks for all Admin SCSS files and fixes them if possible",
        "stylelint:storefront": "Code Style checks for all Storefront SCSS files",
        "stylelint:storefront:fix": "Code Style checks for all Storefront SCSS files and fixes them if possible",
        "format:admin": "Dry run Prettier for the Administration",
        "format:admin:fix": "Format the Administration with Prettier",
        "ludtwig:storefront": "Codestyle checks for all Storefront twig files using ludtwig",
        "ludtwig:storefront:fix": "Auto-fixes all fixable twig codestyle in Storefront",
        "hook:pre-commit:install": "Installs the pre-commit git hook",
        "hook:pre-push:install": "Installs the pre-push git hook",
        "cs": "Checks all files regarding the PHP-CS-Fixer (dry-run)",
        "cs-fix": "Checks all files regarding the PHP-CS-Fixer and fixes them if possible",
        "phpstan": "Launches the PHP static analysis tool",
        "phpunit": "Launches the PHP unit test-suite",
        "rector": "Apply automated refactorings with Rector",
        "rector-dry": "Preview automated refactorings with Rector (dry-run)"
    }
}
