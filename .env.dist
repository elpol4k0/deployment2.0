# Run './bin/console system:setup' to generate a .env file, or copy this file to .env and fill in the values.

APP_ENV=dev
APP_SECRET=change-me-to-a-random-string-32-chars-min
APP_URL=https://[DOMAIN]
APP_TIMEZONE=Europe/Berlin
INSTANCE_ID=change-me-to-a-random-string-32-chars-min

DATABASE_URL=mysql://shopware:shopware@127.0.0.1:3306/shopware

MAILER_DSN=null://null
# MAILER_DSN=smtp://mailpit:1025  # when using docker-compose mailpit service
# MAILER_DSN=smtp://user:pass@smtp.example.com:587

# Blue/Green Deployment (0 = disabled)
BLUE_GREEN_DEPLOYMENT=0

# Shopware
#SHOPWARE_HTTP_CACHE_ENABLED=1
#SHOPWARE_HTTP_DEFAULT_TTL=7200
#SHOPWARE_SKIP_THEME_COMPILE=false
#SHOPWARE_ES_ENABLED=0
#SHOPWARE_ES_INDEXING_ENABLED=0
#SHOPWARE_ES_HOSTS=localhost:9200

# Storage
#SHOPWARE_CDN_STRATEGY_DEFAULT=id

# Messenger / Queue
#MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Redis (optional)
# SHOPWARE_CACHE_ID=
# REDIS_URL=redis://redis:6379  # when using docker-compose redis service

# Locale & Currency
#SHOPWARE_FALLBACK_LOCALE=de-DE

